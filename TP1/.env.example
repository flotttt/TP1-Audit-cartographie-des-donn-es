# PostgreSQL
POSTGRES_DB=eonet
POSTGRES_USER=eonet
POSTGRES_PASSWORD=change-me

# Worker EONET
EONET_STATUS=open           # open | closed | all
EONET_DAYS=30               # fenêtre en jours (vide = pas de filtre)
EONET_LIMIT=50              # nb max d'événements récupérés (vide = pas de limite)
WORKER_INTERVAL_SECONDS=900 # fréquence de synchro (0 = une seule passe puis arrêt)

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@eonet.com   # éviter les TLD réservés (.local est refusé)
PGADMIN_DEFAULT_PASSWORD=change-me
